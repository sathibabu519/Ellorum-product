# Copy to .env.local and fill in. Never commit real values.
#
# WARNING: every VUE_APP_* variable is inlined into the public JS bundle at
# build time, so it must never hold a secret (API key, token, password).

VUE_APP_GRAPHQL_HTTP=https://graphqlzero.almansi.me/api

# Apollo Studio / Engine settings, used only by apollo.config.js tooling
# (not bundled). Keep the key in .env.local, which is git-ignored.
VUE_APP_APOLLO_ENGINE_SERVICE=
VUE_APP_APOLLO_ENGINE_KEY=
